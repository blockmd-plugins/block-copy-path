{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-copy-path",
  "name": {
    "zh": "复制路径",
    "en": "Copy Path"
  },
  "version": "1.0.0",
  "category": "tools",
  "author": "Block Community",
  "repo": "blockmd-plugins/block-copy-path",
  "summary": {
    "zh": "像 VS Code 一样一键复制笔记或文件夹路径，方便贴给终端或 AI 助手",
    "en": "Copy a note or folder path in one click like VS Code, ready to paste into terminals or AI"
  },
  "entry": {
    "js": "main.js"
  },
  "permissions": [
    "storage",
    "ui:commands",
    "ui:sidebar",
    "notes:path",
    "system:clipboard_write"
  ],
  "permission_reasons": {
    "storage": {
      "zh": "记住你常用的路径复制格式",
      "en": "Remember your preferred path copy format"
    },
    "ui:commands": {
      "zh": "在页面菜单、标签页右键和快捷键 Cmd+Shift+C 中添加复制入口",
      "en": "Add the copy action to the page menu, tab menu, and Cmd+Shift+C shortcut"
    },
    "ui:sidebar": {
      "zh": "在侧栏笔记和文件夹的右键菜单中添加复制入口",
      "en": "Add the copy action to the sidebar right-click menu for notes and folders"
    },
    "notes:path": {
      "zh": "获取当前选中或打开的笔记、文件夹文件路径",
      "en": "Get the file path of the selected or currently open note or folder"
    },
    "system:clipboard_write": {
      "zh": "把复制的路径写入系统剪贴板",
      "en": "Write the copied path to the system clipboard"
    }
  },
  "surfaces": [
    "settings_page"
  ],
  "contributes": {
    "commands": [
      {
        "id": "copy_path",
        "title": {
          "zh": "复制文件路径",
          "en": "Copy File Path"
        },
        "shortcut": "cmd-shift-c"
      }
    ],
    "page_menu": [
      {
        "id": "copy_path",
        "title": {
          "zh": "复制文件路径",
          "en": "Copy File Path"
        },
        "command": "copy_path"
      }
    ],
    "tab_menu": [
      {
        "id": "copy_path",
        "title": {
          "zh": "复制文件路径",
          "en": "Copy File Path"
        },
        "command": "copy_path"
      }
    ],
    "sidebar_menu": [
      {
        "id": "copy_path",
        "title": {
          "zh": "复制路径",
          "en": "Copy Path"
        },
        "command": "copy_path",
        "targets": [
          "note",
          "folder"
        ]
      }
    ]
  },
  "icon": {
    "view_box": "0 0 24 24",
    "fill_paths": [
      "M10.25 8.25h7.5a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-7.5a2 2 0 0 1-2-2v-7.5a2 2 0 0 1 2-2Z"
    ],
    "stroke_paths": [
      "M10.25 8.25h7.5a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-7.5a2 2 0 0 1-2-2v-7.5a2 2 0 0 1 2-2Z",
      "M15.75 8.25V5.75a1.5 1.5 0 0 0-1.5-1.5h-8.5a1.5 1.5 0 0 0-1.5 1.5v8.5a1.5 1.5 0 0 0 1.5 1.5h2.5"
    ],
    "accent_paths": [
      "M11.5 14h5"
    ]
  }
}
